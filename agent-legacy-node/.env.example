# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ─── SendPulse ────────────────────────────────────────────────────────────────
SENDPULSE_API_ID=TU_API_ID_AQUI
SENDPULSE_API_SECRET=TU_API_SECRET_AQUI
# Opcional: si ya sabés el bot_id, ponelo acá y no se auto-detecta
# SENDPULSE_BOT_ID=TU_BOT_ID_AQUI

# ─── Configuración ───────────────────────────────────────────────────────────
# Número donde el bot envía notificaciones a Ricardo (sin '+')
RICARDO_PHONE=5491134583958

# Número PERSONAL de Ricardo → activa el agente de agenda personal (sin '+')
AGENDA_PHONE=5491144350180

PORT=3000
NODE_ENV=development

# Nivel de logs: error, warn, info, debug
LOG_LEVEL=info

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=./data/solarpower.db
